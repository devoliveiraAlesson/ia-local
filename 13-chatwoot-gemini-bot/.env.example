# ─────────────────────────────────────────────
# SEGURANÇA
# ─────────────────────────────────────────────
# Gere com: openssl rand -hex 64
SECRET_KEY_BASE=TROQUE_POR_UMA_CHAVE_SEGURA_64_CHARS

# ─────────────────────────────────────────────
# BANCO DE DADOS
# ─────────────────────────────────────────────
POSTGRES_PASSWORD=chatwoot_senha_forte

# ─────────────────────────────────────────────
# CHATWOOT
# ─────────────────────────────────────────────
# URL pública do Chatwoot (mude para seu domínio em produção)
CHATWOOT_URL=http://localhost:3000

# Após criar conta no Chatwoot, gere em: Configurações > Integrações > API
CHATWOOT_API_TOKEN=SEU_TOKEN_AQUI
CHATWOOT_ACCOUNT_ID=1

# ─────────────────────────────────────────────
# GEMINI
# ─────────────────────────────────────────────
GEMINI_API_KEY=SUA_API_KEY_GEMINI

# ─────────────────────────────────────────────
# BOT
# ─────────────────────────────────────────────
# Segredo para validar webhooks do Chatwoot
BOT_WEBHOOK_SECRET=webhook_segredo_forte

# ID da inbox que o bot deve monitorar (opcional — se vazio, monitora todas)
BOT_INBOX_ID=

# ─────────────────────────────────────────────
# EMAIL (opcional — para Chatwoot enviar emails)
# ─────────────────────────────────────────────
MAILER_SENDER_EMAIL=noreply@seudominio.com
SMTP_ADDRESS=
SMTP_USERNAME=
SMTP_PASSWORD=
